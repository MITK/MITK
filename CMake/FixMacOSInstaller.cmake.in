cmake_policy(SET CMP0012 NEW) # if() recognizes numbers and boolean constants.

include("@MITK_SOURCE_DIR@/CMake/mitkMachOTools.cmake")

file(GLOB bundle_paths LIST_DIRECTORIES TRUE "${CPACK_TEMPORARY_INSTALL_DIRECTORY}/*.app")

foreach(bundle_path IN LISTS bundle_paths)
  get_filename_component(bundle_name ${bundle_path} NAME)
  message("  Fixing ${bundle_name}")

  ###########################
  # Thin universal binaries #
  ###########################

  #[[file(GLOB_RECURSE all_files LIST_DIRECTORIES FALSE "${bundle_path}/*")
  message("    Thinning universal binaries to @CMAKE_OSX_ARCHITECTURES@...")
  foreach(file_path IN LISTS all_files)
    execute_process(COMMAND file "${file_path}" OUTPUT_VARIABLE file_info)
    if(file_info MATCHES "universal")
      execute_process(COMMAND lipo -info "${file_path}" OUTPUT_VARIABLE lipo_info)
      if(lipo_info MATCHES "@CMAKE_OSX_ARCHITECTURES@")
        execute_process(COMMAND lipo -thin "@CMAKE_OSX_ARCHITECTURES@" "${file_path}" -output "${file_path}")
      endif()
    endif()
  endforeach()]]

  # Qt framework RPATH fixups are no longer needed here.
  # qt_generate_deploy_app_script() deploys Qt frameworks with correct RPATHs.

  get_filename_component(app ${bundle_path} NAME_WE)
  set(app_path "${bundle_path}/Contents/MacOS/${app}")

  if(@MITK_USE_Python3@) # MITK_USE_Python3

    #################################
    # Convert Python into framework #
    #################################

    message("    Convert Python into framework")
    set(python_framework_path "${bundle_path}/Contents/Frameworks/Python.framework")
    execute_process(
      COMMAND ${CMAKE_COMMAND} -E make_directory "Versions/A/Resources"
      WORKING_DIRECTORY "${python_framework_path}"
    )
    execute_process(
      COMMAND ${CMAKE_COMMAND} -E rename "Info.plist" "Versions/A/Resources/Info.plist"
      COMMAND ${CMAKE_COMMAND} -E create_symlink "A" "Versions/Current"
      COMMAND ${CMAKE_COMMAND} -E rename "bin" "Versions/A/bin"
      COMMAND ${CMAKE_COMMAND} -E rename "include/python3.@Python3_VERSION_MINOR@" "Versions/A/Headers"
      COMMAND ${CMAKE_COMMAND} -E rename "lib" "Versions/A/lib"
      COMMAND ${CMAKE_COMMAND} -E rename "share" "Versions/A/share"
      WORKING_DIRECTORY "${python_framework_path}"
    )
    execute_process(
      COMMAND ${CMAKE_COMMAND} -E create_symlink "Versions/Current/Headers" "Headers"
      COMMAND ${CMAKE_COMMAND} -E create_symlink "Versions/Current/Resources" "Resources"
      COMMAND ${CMAKE_COMMAND} -E rename "Versions/A/lib/libpython3.@Python3_VERSION_MINOR@.dylib" "Versions/A/Python"
      COMMAND ${CMAKE_COMMAND} -E rm -rf "include"
      WORKING_DIRECTORY "${python_framework_path}"
    )
    execute_process(
      COMMAND ${CMAKE_COMMAND} -E create_symlink "../Python" "Versions/A/lib/libpython3.@Python3_VERSION_MINOR@.dylib"
      COMMAND ${CMAKE_COMMAND} -E create_symlink "Versions/Current/Python" "Python"
      WORKING_DIRECTORY "${python_framework_path}"
    )

    ###############################################
    # Re-anchor @loader_path references of Python #
    ###############################################

    # The conversion moved bin/ and lib/ into Versions/A/, two directories
    # deeper. A reference relative to @loader_path that leaves the moved
    # directories, such as the ones of the mitk module to the bundle's
    # libraries, misses its target since then.

    message("    Re-anchoring @loader_path references of the Python framework")
    set(version_path "${python_framework_path}/Versions/A")
    foreach(moved_dir bin lib)
      mitk_macho_files(binaries "${version_path}/${moved_dir}")
      foreach(binary IN LISTS binaries)
        file(RELATIVE_PATH binary_rel "${version_path}" "${binary}")
        get_filename_component(old_dir "${python_framework_path}/${binary_rel}" DIRECTORY)
        get_filename_component(new_dir "${binary}" DIRECTORY)
        mitk_macho_read("${binary}" DEPENDENCIES deps WEAK_DEPENDENCIES weak_deps RPATHS rpaths)
        set(args "")
        foreach(kind change rpath)
          if(kind STREQUAL "change")
            set(entries ${deps} ${weak_deps})
          else()
            set(entries ${rpaths})
          endif()
          foreach(entry IN LISTS entries)
            if(NOT entry MATCHES "^@loader_path(/.*)?$")
              continue()
            endif()
            set(target "${old_dir}${CMAKE_MATCH_1}")
            cmake_path(NORMAL_PATH target)
            string(REGEX REPLACE "/$" "" target "${target}")
            foreach(dir bin lib)
              set(old_prefix "${python_framework_path}/${dir}")
              string(FIND "${target}/" "${old_prefix}/" position)
              if(position EQUAL 0)
                string(LENGTH "${old_prefix}" old_prefix_length)
                string(SUBSTRING "${target}" ${old_prefix_length} -1 rest)
                set(target "${version_path}/${dir}${rest}")
              endif()
            endforeach()
            file(RELATIVE_PATH target_rel "${new_dir}" "${target}")
            if(target_rel STREQUAL "")
              set(new_entry "@loader_path")
            else()
              set(new_entry "@loader_path/${target_rel}")
            endif()
            string(REGEX REPLACE "/$" "" entry_without_slash "${entry}")
            if(NOT new_entry STREQUAL entry_without_slash)
              list(APPEND args "-${kind}" "${entry}" "${new_entry}")
            endif()
          endforeach()
        endforeach()
        if(args)
          execute_process(COMMAND install_name_tool ${args} "${binary}" RESULT_VARIABLE result)
          if(NOT result EQUAL 0)
            message(FATAL_ERROR "install_name_tool failed on ${binary}")
          endif()
        endif()
      endforeach()
    endforeach()

  endif() # MITK_USE_Python3

  ###################
  # Check binaries  #
  ###################

  # Every binary must load on the oldest supported macOS, and every reference
  # must resolve inside the bundle or the system. A library from a package
  # manager that was updated with a newer deployment target, or a reference
  # back into the build host, would otherwise only fail on other machines.

  message("    Checking binaries")
  set(problems "")
  set(executable_dir "${bundle_path}/Contents/MacOS")
  mitk_macho_read("${app_path}" RPATHS app_rpaths)
  mitk_macho_files(binaries "${bundle_path}")
  foreach(binary IN LISTS binaries)
    file(RELATIVE_PATH binary_rel "${bundle_path}" "${binary}")
    mitk_macho_read("${binary}" ID id MINOS minos DEPENDENCIES deps RPATHS rpaths)
    if(minos AND NOT "@CMAKE_OSX_DEPLOYMENT_TARGET@" STREQUAL "" AND minos VERSION_GREATER "@CMAKE_OSX_DEPLOYMENT_TARGET@")
      list(APPEND problems "${binary_rel}: requires macOS ${minos}")
    endif()
    foreach(rpath IN LISTS rpaths)
      if(NOT rpath MATCHES "^@")
        list(APPEND problems "${binary_rel}: absolute LC_RPATH ${rpath}")
      endif()
    endforeach()
    set(search_dirs "")
    foreach(rpath IN LISTS rpaths)
      mitk_macho_expand(dir "${rpath}" "${binary}" "${executable_dir}")
      list(APPEND search_dirs "${dir}")
    endforeach()
    foreach(rpath IN LISTS app_rpaths)
      mitk_macho_expand(dir "${rpath}" "${app_path}" "${executable_dir}")
      list(APPEND search_dirs "${dir}")
    endforeach()
    foreach(dep IN LISTS deps)
      if(dep STREQUAL id OR dep MATCHES "^/(usr/lib|System)/")
        continue()
      endif()
      set(resolved FALSE)
      if(dep MATCHES "^@rpath/(.+)$")
        set(name "${CMAKE_MATCH_1}")
        foreach(dir IN LISTS search_dirs)
          if(EXISTS "${dir}/${name}")
            set(resolved TRUE)
            break()
          endif()
        endforeach()
      elseif(dep MATCHES "^@")
        mitk_macho_expand(path "${dep}" "${binary}" "${executable_dir}")
        if(EXISTS "${path}")
          set(resolved TRUE)
        endif()
      endif()
      if(NOT resolved)
        list(APPEND problems "${binary_rel}: ${dep} does not resolve inside the bundle")
      endif()
    endforeach()
  endforeach()
  if(problems)
    list(JOIN problems "\n  " problems)
    message(FATAL_ERROR "Binaries of ${bundle_name} do not load from the bundle:\n  ${problems}")
  endif()

  # The bundle signature below covers only the code that codesign finds in
  # the standard locations, not the binaries inside site-packages, which the
  # steps above may have changed.
  mitk_macho_resign_invalid(${binaries})

  ############
  # codesign #
  ############

  message("    Signing app bundle with identity \"@MITK_CODESIGN_IDENTITY@\"")
  execute_process(COMMAND
    codesign
      --options runtime
      --entitlements "@MITK_SOURCE_DIR@/CMake/entitlements.plist"
      --force
      --deep
      --sign "@MITK_CODESIGN_IDENTITY@"
      "${bundle_path}"
  )

endforeach()
