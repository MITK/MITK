<statemachine NAME="RegistrationManipulationInteractor">
    <state name="start" startstate="true" >
        <!-- Shift+Ctrl+LeftMouse first: must appear before the single-modifier entries
             so the more specific variant is tested first -->
        <transition event_class="MousePressEvent" event_variant="StartScaling" target="scaling">
            <condition name="ScalingEnabled"/>
            <action name="InitScaling"/>
        </transition>
        <!-- Shift+LeftMouse: start translation -->
        <transition event_class="MousePressEvent" event_variant="StartTranslation" target="translating">
            <action name="InitTranslation"/>
        </transition>
        <!-- Ctrl+LeftMouse: start rotation -->
        <transition event_class="MousePressEvent" event_variant="StartRotation" target="rotating">
            <action name="InitRotation"/>
        </transition>
        <!-- Plain LeftMouse: position selection (drag or click) -->
        <transition event_class="MousePressEvent" event_variant="StartSelectPosition" target="selectingPosition">
        </transition>
    </state>

    <state name="translating">
        <transition event_class="MouseMoveEvent" event_variant="Translating" target="translating">
            <action name="Translate"/>
        </transition>
        <!-- All modifier variants for release: the user may still hold Shift when
             releasing the mouse button after a translation gesture -->
        <transition event_class="MouseReleaseEvent" event_variant="EndInteraction" target="start">
            <action name="EndTranslation"/>
        </transition>
        <transition event_class="MouseReleaseEvent" event_variant="EndInteractionShift" target="start">
            <action name="EndTranslation"/>
        </transition>
        <transition event_class="MouseReleaseEvent" event_variant="EndInteractionCtrl" target="start">
            <action name="EndTranslation"/>
        </transition>
        <transition event_class="MouseReleaseEvent" event_variant="EndInteractionShiftCtrl" target="start">
            <action name="EndTranslation"/>
        </transition>
    </state>

    <state name="rotating">
        <transition event_class="MouseMoveEvent" event_variant="Rotating" target="rotating">
            <action name="Rotate"/>
        </transition>
        <transition event_class="MouseReleaseEvent" event_variant="EndInteraction" target="start">
            <action name="EndRotation"/>
        </transition>
        <transition event_class="MouseReleaseEvent" event_variant="EndInteractionShift" target="start">
            <action name="EndRotation"/>
        </transition>
        <transition event_class="MouseReleaseEvent" event_variant="EndInteractionCtrl" target="start">
            <action name="EndRotation"/>
        </transition>
        <transition event_class="MouseReleaseEvent" event_variant="EndInteractionShiftCtrl" target="start">
            <action name="EndRotation"/>
        </transition>
    </state>

    <state name="scaling">
        <transition event_class="MouseMoveEvent" event_variant="Scaling" target="scaling">
            <action name="Scale"/>
        </transition>
        <transition event_class="MouseReleaseEvent" event_variant="EndInteraction" target="start">
            <action name="EndScaling"/>
        </transition>
        <transition event_class="MouseReleaseEvent" event_variant="EndInteractionShift" target="start">
            <action name="EndScaling"/>
        </transition>
        <transition event_class="MouseReleaseEvent" event_variant="EndInteractionCtrl" target="start">
            <action name="EndScaling"/>
        </transition>
        <transition event_class="MouseReleaseEvent" event_variant="EndInteractionShiftCtrl" target="start">
            <action name="EndScaling"/>
        </transition>
    </state>

    <!-- Plain LMB: drag updates position continuously; release also fires SelectPosition -->
    <state name="selectingPosition">
        <transition event_class="MouseMoveEvent" event_variant="SelectingPosition" target="selectingPosition">
            <action name="SelectPosition"/>
        </transition>
        <transition event_class="MouseReleaseEvent" event_variant="EndInteraction" target="start">
            <action name="SelectPosition"/>
        </transition>
    </state>
</statemachine>
