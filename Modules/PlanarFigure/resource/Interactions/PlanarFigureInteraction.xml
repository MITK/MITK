<statemachine NAME="PlanarFigureInteractor">
  <state name="Idle" startstate="true">
    <transition event_class="MouseMoveEvent" event_variant="MouseMove" target="Idle">
      <condition name="is_stamp" />
      <action name="move_stamp" />
    </transition>
    <transition event_class="MousePressEvent" event_variant="PrimaryButtonPressed" target="AwaitRelease">
      <condition name="is_stamp" />
      <condition name="is_inside_slice" />
      <action name="move_stamp" />
      <action name="end_placement" />
    </transition>
    <!-- Beside the image, a press places no stamp, and the armed stamp keeps it from other interaction. -->
    <transition event_class="MousePressEvent" event_variant="PrimaryButtonPressed" target="Idle">
      <condition name="is_stamp" />
    </transition>
    <!-- The stamp follows the mouse, so it leaves with it. -->
    <transition event_class="InternalEvent" event_variant="LeaveRenderWindow" target="Idle">
      <condition name="is_stamp" />
      <action name="hide_stamp" />
    </transition>

    <transition event_class="MouseMoveEvent" event_variant="MouseMove" target="Hovering">
      <condition name="is_complete" />
      <condition name="is_hit" />
      <action name="update_hover" />
    </transition>
    <transition event_class="MousePressEvent" event_variant="PrimaryButtonPressed" target="Pressed">
      <condition name="is_complete" />
      <condition name="is_hit" />
      <action name="update_hover" />
      <action name="press" />
    </transition>

    <transition event_class="MousePressEvent" event_variant="PrimaryButtonPressed" target="SpanPressed">
      <condition name="is_empty" />
      <condition name="is_on_flat_plane" />
      <condition name="is_placed_by_span" />
      <action name="begin_placement" />
    </transition>
    <transition event_class="MousePressEvent" event_variant="PrimaryButtonPressed" target="Sequence">
      <condition name="is_empty" />
      <condition name="is_on_flat_plane" />
      <action name="begin_placement" />
    </transition>
  </state>

  <state name="Hovering">
    <transition event_class="MouseMoveEvent" event_variant="MouseMove" target="Hovering">
      <condition name="is_hit" />
      <action name="update_hover" />
    </transition>
    <transition event_class="MouseMoveEvent" event_variant="MouseMove" target="Idle">
      <action name="end_hover" />
    </transition>
    <transition event_class="MousePressEvent" event_variant="PrimaryButtonPressed" target="Pressed">
      <condition name="is_hit" />
      <action name="update_hover" />
      <action name="press" />
    </transition>
    <transition event_class="InteractionKeyEvent" event_variant="CtrlKeyPressed" target="Hovering">
      <action name="update_hover" />
    </transition>
    <transition event_class="InteractionKeyReleaseEvent" event_variant="CtrlKeyReleased" target="Hovering">
      <action name="update_hover" />
    </transition>
    <transition event_class="MousePressEvent" event_variant="CtrlPrimaryButtonPressed" target="AwaitRelease">
      <condition name="is_removable" />
      <action name="remove_point" />
    </transition>
    <transition event_class="MousePressEvent" event_variant="CtrlPrimaryButtonPressed" target="Dragging">
      <condition name="is_insertable" />
      <action name="insert_point" />
    </transition>
    <transition event_class="InternalEvent" event_variant="LeaveRenderWindow" target="Idle">
      <action name="end_hover" />
    </transition>
  </state>

  <state name="Pressed">
    <transition event_class="MouseMoveEvent" event_variant="PrimaryButtonPressedAndMouseMove" target="Dragging">
      <condition name="is_beyond_drag_threshold" />
      <action name="drag" />
    </transition>
    <transition event_class="MouseMoveEvent" event_variant="PrimaryButtonPressedAndMouseMove" target="Pressed" />
    <transition event_class="MouseReleaseEvent" event_variant="PrimaryButtonReleased" target="Hovering">
      <action name="update_hover" />
    </transition>
  </state>

  <state name="Dragging">
    <transition event_class="MouseMoveEvent" event_variant="PrimaryButtonPressedAndMouseMove" target="Dragging">
      <action name="drag" />
    </transition>
    <transition event_class="MouseReleaseEvent" event_variant="PrimaryButtonReleased" target="Hovering">
      <action name="end_drag" />
      <action name="update_hover" />
    </transition>
  </state>

  <state name="AwaitRelease">
    <transition event_class="MouseMoveEvent" event_variant="PrimaryButtonPressedAndMouseMove" target="AwaitRelease" />
    <transition event_class="MouseReleaseEvent" event_variant="PrimaryButtonReleased" target="Hovering">
      <action name="update_hover" />
    </transition>
  </state>

  <!-- A span is placed by a press, a drag and a release, or by two clicks. -->
  <state name="SpanPressed">
    <transition event_class="MouseMoveEvent" event_variant="PrimaryButtonPressedAndMouseMove" target="SpanPressed">
      <action name="move_floating_point" />
    </transition>
    <transition event_class="MouseReleaseEvent" event_variant="PrimaryButtonReleased" target="Idle">
      <condition name="is_beyond_drag_threshold" />
      <action name="move_floating_point" />
      <action name="end_placement" />
    </transition>
    <transition event_class="MouseReleaseEvent" event_variant="PrimaryButtonReleased" target="SpanClicked" />
  </state>

  <state name="SpanClicked">
    <transition event_class="MouseMoveEvent" event_variant="MouseMove" target="SpanClicked">
      <action name="move_floating_point" />
    </transition>
    <transition event_class="MousePressEvent" event_variant="PrimaryButtonPressed" target="AwaitRelease">
      <condition name="is_beyond_drag_threshold" />
      <action name="move_floating_point" />
      <action name="end_placement" />
    </transition>
    <transition event_class="MousePressEvent" event_variant="PrimaryButtonPressed" target="SpanClicked" />
    <transition event_class="MouseDoubleClickEvent" event_variant="PrimaryButtonDoubleClick" target="SpanClicked" />
  </state>

  <!-- Points are placed by clicks; the last one follows the mouse until it is placed as well. -->
  <state name="Sequence">
    <transition event_class="MouseMoveEvent" event_variant="MouseMove" target="Sequence">
      <action name="move_floating_point" />
    </transition>
    <transition event_class="MouseMoveEvent" event_variant="PrimaryButtonPressedAndMouseMove" target="Sequence">
      <action name="move_floating_point" />
    </transition>
    <transition event_class="MousePressEvent" event_variant="PrimaryButtonPressed" target="AwaitRelease">
      <condition name="is_valid_point" />
      <condition name="reaches_maximum" />
      <action name="move_floating_point" />
      <action name="end_placement" />
    </transition>
    <transition event_class="MousePressEvent" event_variant="PrimaryButtonPressed" target="Sequence">
      <condition name="is_valid_point" />
      <action name="append_point" />
    </transition>
    <transition event_class="MousePressEvent" event_variant="PrimaryButtonPressed" target="Sequence" />
    <!-- Qt sends press, release, double click, release; the press already placed the point. -->
    <transition event_class="MouseDoubleClickEvent" event_variant="PrimaryButtonDoubleClick" target="AwaitRelease">
      <condition name="can_finish" />
      <action name="remove_floating_point" />
      <action name="end_placement" />
    </transition>
    <transition event_class="MouseDoubleClickEvent" event_variant="PrimaryButtonDoubleClick" target="Sequence" />
    <transition event_class="InteractionKeyEvent" event_variant="Finish" target="Idle">
      <condition name="can_finish" />
      <action name="remove_floating_point" />
      <action name="end_placement" />
    </transition>
    <transition event_class="InteractionKeyEvent" event_variant="RemoveLastPoint" target="Sequence">
      <action name="remove_last_point" />
    </transition>
    <transition event_class="MouseReleaseEvent" event_variant="PrimaryButtonReleased" target="Sequence" />
  </state>
</statemachine>
