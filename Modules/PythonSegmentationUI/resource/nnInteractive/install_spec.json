{
  "FileFormat": "MITK PipInstallSpec",
  "Version": 1,
  "name": "nnInteractive",
  "venvName": "nnInteractive",
  "upgradePipFirst": true,
  "groups": [
    {
      "requirements": [
        "torch>=2.8.0,<2.9.0",
        "torchvision>=0.23.0,<1.0.0"
      ],
      "indexUrl": "${cudaIndexUrl}",
      "extraPipArgs": []
    },
    {
      "requirements": [
        "nninteractive>=1.1.2,<2.0.0"
      ],
      "indexUrl": "",
      "extraPipArgs": []
    }
  ],
  "huggingFaceDownloads": [
    {
      "repoId": "nnInteractive/nnInteractive",
      "allowPatterns": [
        "${modelCheckpoint}/*"
      ],
      "displayName": "model checkpoint ${modelCheckpoint}",
      "optional": true
    }
  ]
}
