   <item>
    <widget class="QGroupBox" name="groupBox">
     <property name="title">
      <string>VoxTell</string>
     </property>
     <layout class="QGridLayout" name="gridLayout">
      <item row="0" column="0">
       <widget class="QPushButton" name="initializeButton">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Minimum" vsizetype="Fixed">
          <horstretch>1</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="text">
         <string>Initialize</string>
        </property>
        <property name="checkable">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QPushButton" name="settingsButton">
        <property name="text">
         <string>Settings</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0" colspan="2">
       <widget class="QmitkLineCompletionTextEdit" name="promptsTextEdit">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="minimumSize">
         <size>
          <width>0</width>
          <height>72</height>
         </size>
        </property>
        <property name="maximumSize">
         <size>
          <width>16777215</width>
          <height>144</height>
         </size>
        </property>
        <property name="toolTip">
         <string>Describe the structures to segment in free text, one prompt per line. While you type, the prompts that VoxTell knows are suggested.</string>
        </property>
        <property name="placeholderText">
         <string>One prompt per line, e.g. liver</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QPushButton" name="segmentButton">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="toolTip">
         <string>Segment the prompts (Ctrl+Enter).</string>
        </property>
        <property name="text">
         <string>Segment</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QCheckBox" name="autoConfirmCheckBox">
        <property name="toolTip">
         <string>Add the result to the segmentation as soon as a run succeeds, as Confirm Segmentation does. Undo removes it again.</string>
        </property>
        <property name="text">
         <string>Auto-confirm on success</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0" colspan="2">
       <widget class="QCheckBox" name="createGroupsCheckBox">
        <property name="toolTip">
         <string>Put each result into a group where it overlaps neither an existing label nor another result, and add a group if there is none. Existing labels stay unchanged. Otherwise all results go into the active group, where later results take the voxels of earlier ones and of existing labels.</string>
        </property>
        <property name="text">
         <string>Create groups as needed</string>
        </property>
       </widget>
      </item>
      <item row="5" column="0" colspan="2">
       <widget class="QmitkInfoCard" name="statusCard"/>
      </item>
