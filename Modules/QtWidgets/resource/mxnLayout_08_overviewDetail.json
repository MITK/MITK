      },
      {
        "type": "window",
        "id": "mxn__widget1",
        "name": "Detail",
        "view_direction": "axial",
        "links": {
          "selection": "main",
          "crosshair": "main",
          "slice": "main",
          "zoom": {
            "target": "main",
            "offset": 4.0
          },
          "pan": "main",
          "windowing": "main",
          "lut": "main"
        },
        "size": 3
      }
    ]
