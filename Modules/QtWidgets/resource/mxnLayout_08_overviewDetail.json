{
  "version": "3.0",
  "name": "Overview + detail",
  "groups": {
    "main": {
      "select_all": true
    }
  },
  "root": {
    "type": "split",
    "orientation": "horizontal",
    "children": [
      {
        "type": "window",
        "id": "mxn__widget0",
        "name": "Overview",
        "view_direction": "axial",
