{
  "version": "2.0",
  "name": "Two rows with each view direction",
  "groups": {
    "main": {
      "select_all": true
    },
    "row2": {
      "select_all": true
    }
  },
  "root": {
    "type": "split",
    "orientation": "vertical",
    "children": [
      {
        "type": "split",
        "orientation": "horizontal",
        "children": [
          {
            "type": "window",
            "id": "widget0",
            "name": "Row 1 - Axial",
            "view_direction": "axial",
            "links": {
              "selection": "main"
            },
            "size": 1
          },
          {
            "type": "window",
            "id": "widget1",
            "name": "Row 1 - Sagittal",
            "view_direction": "sagittal",
            "links": {
              "selection": "main"
            },
            "size": 1
          },
          {
            "type": "window",
            "id": "widget2",
            "name": "Row 1 - Coronal",
            "view_direction": "coronal",
            "links": {
              "selection": "main"
            },
            "size": 1
          }
        ],
        "size": 1
      },
      {
        "type": "split",
        "orientation": "horizontal",
        "children": [
          {
            "type": "window",
            "id": "widget3",
            "name": "Row 2 - Axial",
            "view_direction": "axial",
            "links": {
              "selection": "row2"
            },
            "size": 1
          },
          {
            "type": "window",
            "id": "widget4",
            "name": "Row 2 - Sagittal",
            "view_direction": "sagittal",
            "links": {
              "selection": "row2"
            },
            "size": 1
          },
          {
            "type": "window",
            "id": "widget5",
            "name": "Row 2 - Coronal",
            "view_direction": "coronal",
            "links": {
              "selection": "row2"
            },
            "size": 1
          }
        ],
        "size": 1
      }
    ]
  }
}
