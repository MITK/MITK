   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="warningLabel">
     <property name="text">
      <string>Every action below deliberately breaks this session to exercise the crash-dump facility. Save your work before using them.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="debuggerNoteLabel">
     <property name="text">
      <string>Note: under a debugger (Visual Studio F5), a hard crash breaks into the debugger and no dump is written. Use Start Without Debugging (Ctrl+F5) or startMitkWorkbench_release.bat to capture real crashes. On-demand and freeze snapshots still work under a debugger.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QPushButton" name="crashButton">
     <property name="toolTip">
      <string>Null-pointer write on the UI thread. The application terminates immediately; the next start offers the crash dump (unless running under a debugger - see the note above).</string>
     </property>
     <property name="text">
      <string>Trigger hard crash</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QPushButton" name="exceptionButton">
     <property name="toolTip">
      <string>Throws a mitk::Exception out of the event handler. In safe mode (the default) the top-level error dialog with &quot;Capture diagnostics&quot; appears.</string>
     </property>
     <property name="text">
      <string>Throw unhandled exception</string>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="freezeLayout">
     <item>
      <widget class="QPushButton" name="freezeButton">
       <property name="toolTip">
        <string>Blocks the UI thread for the chosen duration. With the UI-freeze watchdog enabled (e.g. --ui-watchdog 5), provisional dumps are captured while frozen.</string>
       </property>
       <property name="text">
        <string>Freeze UI thread</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QSpinBox" name="freezeDurationSpinBox">
