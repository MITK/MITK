<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <extension point="org.blueberry.ui.editors">
    <editor id="org.mitk.editors.mxnmultiwidget"
			name="MxN Display"
			extensions="mitk"
			icon="resources/MxNMultiWidgetEditor.svg">
      <class class="QmitkMxNMultiWidgetEditor">
        <!-- The stock editor's legacy widget name: saved layouts and the REST
             alias carry window IDs with this prefix. -->
        <parameter name="widgetName" value="mxn"/>
      </class>
    </editor>
  </extension>

  <extension point="org.blueberry.ui.views">
    <view id="org.mitk.views.mxnlayouteditor"
          name="MxN Layout Editor"
          class="QmitkMxNLayoutEditorView"
          icon="resources/MxNMultiWidgetEditor.svg"
          category="General"/>
  </extension>

  <extension point="org.blueberry.ui.preferencePages">
    <page id="org.mitk.MxNMultiWidgetEditorPreferencePage"
		  name="MxN Display"
		  class="QmitkMxNMultiWidgetEditorPreferencePage"
		  category="org.mitk.EditorsPreferencePage">
      <keywordreference id="org.mitk.MxNMultiWidgetEditorPreferencePageKeywords"/>
    </page>
  </extension>

  <extension point="org.blueberry.ui.keywords">
    <keyword id="org.mitk.MxNMultiWidgetEditorPreferencePageKeywords" label="level window readout"/>
    <keyword id="org.mitk.MxNMultiWidgetEditorPreferencePageKeywords" label="expanded navigator"/>
    <keyword id="org.mitk.MxNMultiWidgetEditorPreferencePageKeywords" label="pacs like mouse interaction select left mouse button action"/>
    <keyword id="org.mitk.MxNMultiWidgetEditorPreferencePageKeywords" label="crosshair gap size"/>
  </extension>
</plugin>
