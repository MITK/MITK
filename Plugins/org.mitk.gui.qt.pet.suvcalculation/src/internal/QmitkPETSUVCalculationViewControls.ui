      <item>
       <widget class="QCheckBox" name="checkForcePET">
        <property name="toolTip">
         <string>Bypass the (0008,0060) Modality == &quot;PT&quot; check. Use only if the input is genuinely PET data that lacks a correct Modality tag.</string>
