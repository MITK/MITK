      </item>
      <item>
       <widget class="QCheckBox" name="checkStrictDicom">
        <property name="toolTip">
         <string>Refuse IBSI-SUV-recommended empirical adaptations of borderline / ambiguous DICOM input (Mbq dose, vendor-specific decay-timing fallbacks, ambiguous patient sex). Supply explicit overrides instead.</string>
