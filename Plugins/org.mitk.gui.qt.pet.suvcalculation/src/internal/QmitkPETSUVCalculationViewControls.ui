       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="checkForceBqMl">
        <property name="toolTip">
         <string>Treat the input pixel values as activity concentration in [Bq/mL], regardless of (0054,1001) Units. Only physically meaningful if the input really is in [Bq/mL].</string>
