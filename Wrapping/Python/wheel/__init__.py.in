import os as _os
import sys as _sys

_pkg_dir = _os.path.dirname(_os.path.abspath(__file__))

# Detect wheel install by looking for bundled native libraries.
# delvewheel (Windows) places them at mitk/.libs/ (inside the package),
# delocate (macOS) places them at mitk/.dylibs/ (inside the package),
# auditwheel (Linux) places them at mitk.libs/ (sibling of the package).
_libs_dir = _os.path.join(_pkg_dir, ".libs")
if not _os.path.isdir(_libs_dir):
    _libs_dir = _os.path.join(_pkg_dir, ".dylibs")
if not _os.path.isdir(_libs_dir):
    _libs_dir = _os.path.join(_os.path.dirname(_pkg_dir), "mitk.libs")
_is_wheel = _os.path.isdir(_libs_dir)

if _is_wheel:
    # Tell PreloadPython activator to skip (Python is already loaded).
    _os.environ["PYMITK"] = "1"

    # Tell CppMicroServices where to find auto-load module subdirectories.
    _os.environ["US_AUTOLOAD_PATHS"] = _pkg_dir

    # Windows: register DLL search directory for bundled native libraries.
    # add_dll_directory covers Python extension loading (pyd files), while
    # PATH is needed for CppMicroServices auto-load which uses LoadLibrary.
    if _sys.platform == "win32":
        _os.add_dll_directory(_libs_dir)
        _os.environ["PATH"] = _libs_dir + _os.pathsep + _os.environ.get("PATH", "")
    # Linux: auditwheel sets RPATH to $ORIGIN/../mitk.libs
    # macOS: delocate rewrites @loader_path references

from .mitk import *
from .mitk import Image as NativeImage  # public alias for isinstance checks
from pathlib import Path as _Path


def Image(source=None, /, **kwargs):
    """Create an MITK image from various sources.

    - Image()                 -- empty image (must be initialized later)
    - Image(numpy_array, ...) -- delegate to NativeImage.from_numpy(...)
    - Image(path)             -- delegate to NativeImage.load(path)
    """
    if source is None:
        return NativeImage.new()
    if isinstance(source, (str, _Path)):
        return NativeImage.load(str(source))
    try:
        import numpy as _np
        if isinstance(source, _np.ndarray):
            return NativeImage.from_numpy(source, **kwargs)
    except ImportError:
        pass
    raise TypeError(
        f"mitk.Image() does not support source of type {type(source).__name__}"
    )


__version__ = "@MITK_VERSION_STRING@"
